# Only the fixture zones are served; other names get a fast REFUSED, so no
# query leaves the fixture network.
fixtures.test {
    file /etc/coredns/fixtures.test.zone
    errors
}
53.253.10.in-addr.arpa {
    file /etc/coredns/53.253.10.in-addr.arpa.zone
    errors
}

# Generic names for clients outside the fixture network, such as the
# address a container runtime's port forwarder connects from: PTR for any
# other IPv4 address and the matching A record, like an ISP's generated
# reverse DNS.
in-addr.arpa {
    template IN PTR {
        match "^(?P<d>[0-9]+)[.](?P<c>[0-9]+)[.](?P<b>[0-9]+)[.](?P<a>[0-9]+)[.]in-addr[.]arpa[.]$"
        answer "{{ .Name }} 3600 IN PTR ip-{{ .Group.a }}-{{ .Group.b }}-{{ .Group.c }}-{{ .Group.d }}.peer.fixtures.test."
    }
    errors
}
peer.fixtures.test {
    template IN A {
        match "^ip-(?P<a>[0-9]+)-(?P<b>[0-9]+)-(?P<c>[0-9]+)-(?P<d>[0-9]+)[.]peer[.]fixtures[.]test[.]$"
        answer "{{ .Name }} 3600 IN A {{ .Group.a }}.{{ .Group.b }}.{{ .Group.c }}.{{ .Group.d }}"
        fallthrough
    }
    # Other types for a generated name: NODATA (RFC 2308 section 2.2), so a
    # resolver asking AAAA first still goes on to ask for the A record.
    template IN ANY {
        match "^ip-[0-9]+-[0-9]+-[0-9]+-[0-9]+[.]peer[.]fixtures[.]test[.]$"
        authority "fixtures.test. 3600 IN SOA ns.fixtures.test. hostmaster.fixtures.test. 1 3600 600 86400 3600"
        fallthrough
    }
    template IN ANY {
        rcode NXDOMAIN
        authority "fixtures.test. 3600 IN SOA ns.fixtures.test. hostmaster.fixtures.test. 1 3600 600 86400 3600"
    }
    errors
}
