11  IN PTR modern.fixtures.test.
21  IN PTR ftp.fixtures.test.
22  IN PTR xmpp.fixtures.test.
23  IN PTR ldap.fixtures.test.
24  IN PTR postgres.fixtures.test.
25  IN PTR smtp.fixtures.test.
26  IN PTR mail.fixtures.test.
27  IN PTR mysql.fixtures.test.
35  IN PTR heartbleed.fixtures.test.
36  IN PTR heartbleed-patched.fixtures.test.
37  IN PTR ccs-patched.fixtures.test.
38  IN PTR robot-wolfssl.fixtures.test.
39  IN PTR robot-wolfssl-patched.fixtures.test.
53  IN PTR ns.fixtures.test.
